/**
* COMPUTE !5 = 120 or 0x78
**/

11 00 05     // LI r0 5; calculate 5!
11 01 01     // LI r1 1; temp

// LOOP: ; 0x0006
0B 01 01 00  //     MUL r1 r1 r0; multiply contents of r1 by r0
13 00 00 01  //     SUBI r0 r0 1; decriment contents of r0
06 00 14     //     JMP_ZRO END; if result is zero, end program
03 00 06     //     JMP LOOP; jump to LOOP

// END: ; 0x0014
01 00 FE 01     //     STR 0x00FE r1; store result in RAM location 0x00FE
01 04 00 01     //     STR 0x0400 r1; store result in location 0x0400 (onboard LED peripheral)
00           //     HALT; end program



