11 00 03 // LI R0 0x03
11 07 01 // LI R7 0x01

0A 05 06 07 // SUB 05 06 07 = 0xFF

12 01 00 09 // ADDI R1 R0 0x07 = 0x0C
13 01 00 04 // SUBI R1 R0 0x04 = 0xFF
14 01 00 04 // MULI R1 R0 0x04 = 0x0C
19 01 00 03 // DIVI R1 R0 0x03 = 0x01

15 01 00 02 // ANDI R1 R0 0x02 = 0x02 
16 01 00 03 // ORI  R1 R0 0x03 = 0x03
17 01 00 03 // XORI R1 R0 0x03 = 0x00
18 01 00 03 // EQUI R1 R0 0x03 = 0x01

01 00 04 00 // STR 0x0400 R1
01 00 FF 01 // STR 0x00FF R1
00 // HALT

