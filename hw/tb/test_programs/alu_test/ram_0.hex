/**
* test all ALU ops and check flags
**/

/*
// first test basic arithmetic ops
    LI R0 78
    LI R1 21

    ADD R0 R0 R1
    EQUI R2 R0 99
    JMP_ABV INC_CORRECT_TEST_COUNTER
    ADDI R0 R0 21
    EQUI R2 R0 99
    JMP_ABV INC_CORRECT_TEST_COUNTER

    SUB R0 R0 R1
    EQUI R2 R0 57
    JMP_ABV INC_CORRECT_TEST_COUNTER
    SUBI R0 R0 21
    EQUI R2 R0 57
    JMP_ABV INC_CORRECT_TEST_COUNTER

    LI R0 0F
    LI R1 03

    MUL R0 R0 R1
    EQUI R2 R0 2D
    JMP_ABV INC_CORRECT_TEST_COUNTER
    MULI R0 R0 03
    EQUI R2 R0 2D
    JMP_ABV INC_CORRECT_TEST_COUNTER

    DIV R0 R0 R1
    EQUI R2 R0 05
    JMP_ABV INC_CORRECT_TEST_COUNTER
    DIVI R0 R0 03
    EQUI R2 R0 05
    JMP_ABV INC_CORRECT_TEST_COUNTER

// then test basic logical ops
    LI R0 4D
    LI R1 AE

    AND R0 R0 R1
    EQUI R2 R0 0C
    JMP_ABV INC_CORRECT_TEST_COUNTER
    ANDI R0 R0 AE
    EQUI R2 R0 0C
    JMP_ABV INC_CORRECT_TEST_COUNTER

    OR R0 R0 R1
    EQUI R2 R0 EF
    JMP_ABV INC_CORRECT_TEST_COUNTER
    ORI R0 R0 AE
    EQUI R2 R0 EF
    JMP_ABV INC_CORRECT_TEST_COUNTER

    XOR R0 R0 R1
    EQUI R2 R0 E3
    JMP_ABV INC_CORRECT_TEST_COUNTER
    XORI R0 R0 AE
    EQUI R2 R0 E3
    JMP_ABV INC_CORRECT_TEST_COUNTER

    EQU R0 R0 R1 // unequal
    EQUI R2 R0 00
    JMP_ABV INC_CORRECT_TEST_COUNTER
    EQUI R0 R0 AE
    EQUI R2 R0 00
    JMP_ABV INC_CORRECT_TEST_COUNTER

    LI R0 4D
    LI R1 4D

    EQU R0 R0 R1 // equal
    EQUI R2 R0 01
    JMP_ABV INC_CORRECT_TEST_COUNTER
    EQUI R0 R0 4D
    EQUI R2 R0 01
    JMP_ABV INC_CORRECT_TEST_COUNTER

// test flag gen
...

// store counter and test result in memory loc 0x0300
    EQUI RE RF [no of tests]
    STR 03 01 RE
    STR 03 00 RF
    00


INC_CORRECT_TEST_COUNTER:
    ADDI RF RF 01
    RET

*/
